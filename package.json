{
  "name": "steady-socket",
  "version": "0.0.0",
  "description": "A WebSocket client that stays connected, on the web and in React Native.",
  "keywords": [
    "websocket",
    "reconnect",
    "heartbeat",
    "react",
    "react-native"
  ],
  "license": "MIT",
  "author": "Luís Machado",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalmachado/steady-socket.git"
  },
  "bugs": "https://github.com/lalmachado/steady-socket/issues",
  "homepage": "https://github.com/lalmachado/steady-socket#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./react-native": {
      "import": {
        "types": "./dist/react-native.d.ts",
        "default": "./dist/react-native.js"
      },
      "require": {
        "types": "./dist/react-native.d.cts",
        "default": "./dist/react-native.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile node16"
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
