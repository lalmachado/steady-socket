{
  "name": "steady-socket",
  "version": "0.1.0",
  "description": "A WebSocket client that stays connected, on the web and in React Native.",
  "keywords": [
    "websocket",
    "reconnect",
    "heartbeat",
    "react",
    "react-native"
  ],
  "license": "MIT",
  "author": "Luís Machado",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalmachado/steady-socket.git"
  },
  "bugs": "https://github.com/lalmachado/steady-socket/issues",
  "homepage": "https://github.com/lalmachado/steady-socket#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./react-native": {
      "import": {
        "types": "./dist/react-native.d.ts",
        "default": "./dist/react-native.js"
      },
      "require": {
        "types": "./dist/react-native.d.cts",
        "default": "./dist/react-native.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && attw --pack . --profile node16",
    "size": "size-limit",
    "release": "pnpm build && changeset publish",
    "changeset": "changeset"
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  },
  "size-limit": [
    {
      "name": "core (steady-socket)",
      "path": "dist/index.js",
      "limit": "3 kB",
      "gzip": true
    },
    {
      "name": "react (steady-socket/react)",
      "path": "dist/react.js",
      "limit": "1 kB",
      "ignore": [
        "react"
      ],
      "gzip": true
    },
    {
      "name": "react-native (steady-socket/react-native)",
      "path": "dist/react-native.js",
      "limit": "500 B",
      "gzip": true
    }
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
